<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may call the lab gateway over HTTP on the LAN. Release builds keep cleartext off. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
