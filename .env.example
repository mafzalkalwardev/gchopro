# App runtime. Read by packages/core at boot.
NODE_ENV=

# development, staging, or production. Read by packages/core. Seed refuses production.
APP_ENV=

# Runtime Postgres URL for role gchopro_app. Read by the apps and the worker.
DATABASE_URL=

# Migration Postgres URL for role gchopro_owner. Read by pnpm db:migrate.
DATABASE_OWNER_URL=

# Redis URL including the password. Read by the apps and the worker.
REDIS_URL=

# Hostname for the admin app. Read by admin middleware.
ADMIN_HOST=

# Hostname for the user portal. Read by portal middleware.
PORTAL_HOST=

# Hostname that exposes only /api/devices. Read by portal middleware.
GATEWAY_HOST=

# Public portal origin shown to users. Read by the portal.
PUBLIC_PORTAL_URL=

# Public gateway origin shown in the pairing dialog. Read by the admin app.
PUBLIC_GATEWAY_URL=

# Comma-separated CIDRs of trusted reverse proxies. Read by admin IP checks.
TRUSTED_PROXY_CIDRS=

# Comma-separated CIDRs allowed to open the admin app. Read by admin middleware.
ADMIN_IP_ALLOWLIST=

# JSON map of key id to base64-encoded 32-byte AES keys. Read by field encryption.
FIELD_ENCRYPTION_KEYS=

# Active key id inside FIELD_ENCRYPTION_KEYS. Read by field encryption.
FIELD_ENCRYPTION_ACTIVE_KEY_ID=

# Base64-encoded 32-byte HMAC key for phone-number blind indexes. Read by packages/core.
PHONE_INDEX_KEY=

# Base64-encoded 32-byte pepper for device tokens and pairing codes. Read by packages/core.
TOKEN_PEPPER=

# Base64-encoded 32-byte HMAC key for CSRF tokens. Read by session code.
SESSION_SECRET=

# Positive integer. Read by device-token rotation.
DEVICE_TOKEN_MAX_AGE_DAYS=

# Initial admin username. Read by pnpm db:seed only.
SEED_ADMIN_USERNAME=

# Initial admin password. Read once by pnpm db:seed. Change it at first login.
SEED_ADMIN_PASSWORD=

# Comma-separated E.164 numbers allowed for SIM re-tests. Read by the admin re-test flow.
ADMIN_TEST_NUMBERS=

# DeepL API key. Read by the translation adapter when that provider is selected.
DEEPL_API_KEY=

# DeepL API origin. Read by the translation adapter.
DEEPL_API_URL=

# Google Cloud project id. Read by the Google translation adapter.
GOOGLE_CLOUD_PROJECT=

# Base64-encoded Google service-account JSON. Read by the Google translation adapter.
GOOGLE_TRANSLATE_CREDENTIALS_JSON=

# LibreTranslate origin. Read by the LibreTranslate adapter.
LIBRETRANSLATE_URL=

# LibreTranslate API key. Read by the LibreTranslate adapter.
LIBRETRANSLATE_API_KEY=

# SMTP host. Read by the alert mailer.
SMTP_HOST=

# SMTP port. Read by the alert mailer.
SMTP_PORT=

# SMTP username. Read by the alert mailer.
SMTP_USER=

# SMTP password. Read by the alert mailer.
SMTP_PASS=

# From address for alert email. Read by the alert mailer.
SMTP_FROM=

# Telegram bot token. Read by the alert notifier.
TELEGRAM_BOT_TOKEN=

# Web Push public key. Read when VAPID is enabled.
VAPID_PUBLIC_KEY=

# Web Push private key. Read when VAPID is enabled.
VAPID_PRIVATE_KEY=

# Web Push subject. Read when VAPID is enabled.
VAPID_SUBJECT=

# true or false. Read by the backup job.
BACKUP_ENABLED=

# age public key for backup encryption. The private key stays offline. Read by backup.sh.
BACKUP_AGE_RECIPIENT=

# rclone remote for off-site backups. Read by backup.sh.
BACKUP_RCLONE_REMOTE=

# Days to keep remote backups. Read by the backup job.
BACKUP_RETENTION_DAYS=

# pino level. Read by packages/core.
LOG_LEVEL=

# Postgres superuser/owner password for Docker Compose. Must match DATABASE_OWNER_URL. Not read by the apps.
POSTGRES_PASSWORD=

# Password for role gchopro_app. Must match DATABASE_URL. Read by Compose init, not by the apps.
GCHOPRO_APP_PASSWORD=

# Redis password. Must match REDIS_URL. Read by Compose.
REDIS_PASSWORD=
