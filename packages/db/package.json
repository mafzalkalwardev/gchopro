{
  "name": "@gchopro/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "reencrypt": "tsx src/reencrypt.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@gchopro/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.2",
    "postgres": "^3.4.7",
    "rate-limiter-flexible": "^8.2.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@gchopro/config": "workspace:*",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
