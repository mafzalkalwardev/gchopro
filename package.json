{
  "name": "gchopro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @gchopro/db generate",
    "db:migrate": "pnpm --filter @gchopro/core build && pnpm --filter @gchopro/db migrate",
    "db:seed": "pnpm --filter @gchopro/core build && pnpm --filter @gchopro/db seed",
    "db:reencrypt": "pnpm --filter @gchopro/core build && pnpm --filter @gchopro/db reencrypt",
    "test:integration": "pnpm --filter @gchopro/core build && pnpm --filter @gchopro/db test:integration",
    "gen:secrets": "pnpm --filter @gchopro/core gen:secrets",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.1",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18"
    },
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "ioredis",
      "esbuild",
      "lefthook",
      "unrs-resolver"
    ]
  }
}
